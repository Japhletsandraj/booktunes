# ---------------------------------------------------------------------------
# Booktunes API environment
# Copy to `.env` and fill in. Never commit `.env`.
# ---------------------------------------------------------------------------

ENVIRONMENT=development           # development | staging | production
LOG_LEVEL=INFO
SECRET_KEY=change-me              # openssl rand -hex 32
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Database -------------------------------------------------------------
# Supabase -> Project Settings -> Database -> Connection string -> Session pooler.
#
# MUST be the pooler host, NOT the direct one:
#   direct  db.<ref>.supabase.co               -> IPv6-ONLY (no A record)
#   pooler  aws-0-<region>.pooler.supabase.com -> IPv4, works from Render
# Render has no IPv6 egress, so the direct host fails at startup with
# "[Errno 101] Network is unreachable". Both are port 5432 — easy to mix up.
# Note the pooler username is `postgres.<project-ref>`, not plain `postgres`.
#
# Use the *session pooler* (5432); the transaction pooler (6543) does not
# support prepared statements, which asyncpg relies on.
# The driver prefix is rewritten automatically for async/sync use.
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE=1800

# --- Redis ----------------------------------------------------------------
# Upstash -> database -> "Redis Connect" -> redis:// URL.
# Upstash requires TLS, so the scheme is `rediss://` on their paid-tier hosts.
REDIS_URL=redis://default:PASSWORD@HOST.upstash.io:6379

# --- Playlist curation (Deezer + YouTube Music) ----------------------------
# Nothing to set. Deezer's public API and YouTube Music both work unauthenticated,
# so playlist generation is fully functional out of the box.

# --- Spotify (optional, disabled unless set) -------------------------------
# https://developer.spotify.com/dashboard -> Create app.
# Client Credentials flow only — no redirect URI or user login needed.
#
# Left unset on purpose: apps created after 2024-11-27 get 403 from
# /recommendations and /audio-features, and search now requires the app OWNER
# to hold an active Spotify Premium subscription. Set these only if you have a
# pre-cutoff app or Premium.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Google Books (fallback book source) ----------------------------------
# https://console.cloud.google.com -> APIs & Services -> Credentials -> API key.
# Optional: the API serves ~1000 unauthenticated requests/day without a key.
GOOGLE_BOOKS_API_KEY=

# --- Cloudinary (cover images) --------------------------------------------
# https://console.cloudinary.com -> Dashboard -> API Environment variable.
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# --- Email (Resend) -------------------------------------------------------
RESEND_API_KEY=
ALERT_EMAIL_TO=

# --- Monitoring -----------------------------------------------------------
SENTRY_DSN=
# Free Discord webhook used for free-tier quota alerts (Server Settings ->
# Integrations -> Webhooks -> New Webhook -> Copy URL).
ALERT_WEBHOOK_URL=

# --- CORS -----------------------------------------------------------------
# Must list every origin the browser app is served from. Never "*" — the API
# sends credentials, and browsers reject wildcard + credentials outright.
# 5173 is the Vite dev server (frontend/); 3000 is kept for any legacy client.
# In dev you can also skip CORS entirely: `npm run dev` proxies /api to the
# API, so the page and the requests share one origin.
# List entries must have NO trailing slash — the browser sends Origin as
# scheme://host[:port], so "https://example.com/" never matches.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://booktunes.vercel.app

# Vercel mints a new origin per deployment (booktunes-<hash>-<team>.vercel.app),
# which a fixed list can never cover. This pattern matches them. Leave empty to
# disable. Keep it anchored (^...$) so it cannot match an attacker-controlled
# suffix.
CORS_ORIGIN_REGEX=^https://booktunes-[a-z0-9-]+\.vercel\.app$
ALLOWED_HOSTS=localhost,127.0.0.1,booktunes-api.onrender.com

# --- ML / tuning ----------------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Bake the model into the image at build time so cold starts don't download it.
EMBEDDING_CACHE_DIR=/app/.model_cache
MODEL_STORAGE_DIR=/app/.models
RECOMMENDATION_CACHE_TTL=3600
